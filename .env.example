# Copy this file to ".env" and change the values. ".env" is git-ignored: never commit real passwords.
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
# At least 32 random characters. Generate one:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
# The first owner account, created automatically the first time the app starts
OWNER_PHONE=9876543210
OWNER_PASSWORD=ChangeMe123
OWNER_NAME=Owner
