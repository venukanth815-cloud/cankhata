<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.xml = Tomcat's settings file for this app.
  Filter ORDER matters, so filters are declared here (annotations cannot set the order):
  encoding/security headers -> request log -> login check -> role check
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>CanKhata</display-name>

  <filter><filter-name>EncodingFilter</filter-name><filter-class>com.cankhata.filter.EncodingFilter</filter-class></filter>
  <filter><filter-name>RequestLogFilter</filter-name><filter-class>com.cankhata.filter.RequestLogFilter</filter-class></filter>
  <filter><filter-name>AuthFilter</filter-name><filter-class>com.cankhata.filter.AuthFilter</filter-class></filter>
  <filter><filter-name>RoleFilter</filter-name><filter-class>com.cankhata.filter.RoleFilter</filter-class></filter>

  <filter-mapping><filter-name>EncodingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RequestLogFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>RoleFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>

  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>

  <!-- Container-level errors (page not found, crashes before our code runs) -->
  <error-page><error-code>404</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
  <error-page><error-code>500</error-code><location>/WEB-INF/views/error.jsp</location></error-page>

  <!-- We use signed cookies, not Tomcat sessions: never create HttpSession objects -->
  <session-config><session-timeout>1</session-timeout></session-config>

  <!-- Read every JSP and included .jspf as UTF-8 (otherwise emoji in included files turn into garbage) -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <url-pattern>*.jspf</url-pattern>
      <page-encoding>UTF-8</page-encoding>
    </jsp-property-group>
  </jsp-config>
</web-app>
